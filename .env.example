# Скопіюй у .env і заповни. .env у Git не потрапляє.

# NASA Earthdata (NISAR через earthaccess)
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=

# Google Earth Engine (некомерційний проєкт)
GEE_PROJECT=
# Шлях до ключа сервісного акаунта (для Cloud Run), локально можна earthengine authenticate
GOOGLE_APPLICATION_CREDENTIALS=
