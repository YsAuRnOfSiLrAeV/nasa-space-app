# Optional: override the MapLibre basemap style URL.
# Default: public/map/explorer.json (OpenFreeMap + NASA GIBS; colors come from the active theme).
VITE_BASEMAP_STYLE_URL=

# Team API (backend/api, FastAPI). Production builds: the deployed base URL,
# e.g. the Cloud Run service URL. Leave empty when no backend is deployed; the
# demo works without it. The API must allow this site's origin (CORS).
VITE_API_URL=

# Dev only (not exposed to the app): where the Vite proxy sends /api requests.
# Default: http://127.0.0.1:8000 (`uvicorn api.main:app` in backend/).
API_PROXY_TARGET=

# Dev/build only: read demo fires from another folder instead of ../data/demo
# (path relative to frontend/). Must contain an index.json.
FIRE_DEMO_DIR=

# Node-only AppEEARS extraction credentials. Keep real values in .env.local.
# Never prefix these with VITE_. An AppEEARS token may be used instead of login.
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=
APPEEARS_TOKEN=
